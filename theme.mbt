///|
pub let default_theme_css : String =
  #|:root{--paper:#fffdf7;--ink:#24231f;--muted:#746f64;--line:#ded8ca;--accent:#b5462d;--side:#f3eee2;--code:#282c34}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font:17px/1.75 Georgia,"Noto Serif SC",serif}.layout{display:grid;grid-template-columns:290px minmax(0,1fr);min-height:100vh}.sidebar{position:sticky;top:0;height:100vh;overflow:auto;padding:34px 24px;background:var(--side);border-right:1px solid var(--line)}.brand{font-size:24px;font-weight:700;color:var(--ink);text-decoration:none}.search{width:100%;margin:22px 0;padding:10px 12px;border:1px solid var(--line);border-radius:4px;background:#fff}.toc{list-style:none;padding:0}.toc li{margin:8px 0}.toc a{color:var(--muted);text-decoration:none}.toc a:hover,.toc .active{color:var(--accent)}.part{margin-top:24px;text-transform:uppercase;letter-spacing:.12em;font:700 12px sans-serif}.content{width:min(850px,calc(100% - 48px));margin:0 auto;padding:54px 0}.breadcrumbs{font:13px sans-serif;color:var(--muted)}h1,h2,h3{line-height:1.25;margin-top:1.7em}.anchor{opacity:0;margin-left:-1em;padding-right:.25em;color:var(--accent);text-decoration:none}h1:hover .anchor,h2:hover .anchor,h3:hover .anchor{opacity:1}a{color:var(--accent)}pre{overflow:auto;padding:18px;border-radius:6px;background:var(--code);color:#f3f3f3}code{font:14px/1.6 "SFMono-Regular",Consolas,monospace}p code,li code{padding:2px 5px;background:#eee7d9;color:#7b2f20}.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse}th,td{padding:9px 12px;border:1px solid var(--line);text-align:left}blockquote{margin-left:0;padding-left:20px;border-left:4px solid var(--accent);color:var(--muted)}.chapter-nav{display:flex;justify-content:space-between;margin-top:60px;padding-top:20px;border-top:1px solid var(--line)}@media(max-width:760px){.layout{display:block}.sidebar{position:relative;width:100%;height:auto}.content{padding-top:28px}.anchor{opacity:1}}

///|
pub let default_theme_js : String =
  #|(()=>{const box=document.querySelector('[data-search]');if(!box)return;const rows=[...document.querySelectorAll('[data-title]')];let index=[];const script=document.currentScript;const url=new URL('search-index.json',script.src);fetch(url).then(r=>r.ok?r.json():[]).then(data=>{index=data}).catch(()=>{});box.addEventListener('input',()=>{const q=box.value.trim().toLowerCase();const hits=new Set(index.filter(x=>!q||x.title.toLowerCase().includes(q)||x.path.toLowerCase().includes(q)||x.body.toLowerCase().includes(q)).map(x=>x.path));rows.forEach(row=>{const href=row.querySelector('a')?.getAttribute('href')||'';const path=new URL(href,location.href).pathname.split('/').pop();row.hidden=!!q&&!row.dataset.title.toLowerCase().includes(q)&&!hits.has(path)})})})();
