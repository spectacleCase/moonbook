name = "spectacleCase/moonbook"

version = "0.3.0"

readme = "README.md"

repository = "https://github.com/spectacleCase/moonbook.git"

license = "MPL-2.0"

keywords = [ "markdown", "documentation", "static-site", "book", "generator" ]

preferred_target = "native"

description = "A Markdown documentation and book generator written in MoonBit"
